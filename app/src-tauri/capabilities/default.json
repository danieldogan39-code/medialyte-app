{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Standardrechte des Hauptfensters: externe Links öffnen, Fenstergröße merken, signierte Updates einspielen",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "window-state:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-destroy"
  ]
}
