{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medialyte",
  "version": "0.9.5",
  "identifier": "de.medialyte.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Medialyte",
        "width": 1320,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#0A1220",
        "theme": "Dark",
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "category": "Business",
    "shortDescription": "Medialyte",
    "longDescription": "Akquise, Anfragen, Kunden und Rechnungen von Medialyte in einer App.",
    "copyright": "© Medialyte",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
