{
  "appId": "de.medialyte.app",
  "appName": "Medialyte",
  "webDir": "www",
  "android": {
    "backgroundColor": "#0A1220",
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "css"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 15000,
      "responseTimeout": 60,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true,
      "directUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": ""
    }
  },
  "loggingBehavior": "production"
}
